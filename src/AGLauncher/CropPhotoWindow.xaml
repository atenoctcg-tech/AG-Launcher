<Window x:Class="AGLauncher.CropPhotoWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Crop profile photo" Width="650" Height="650"
 WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
 Background="#080A0D" Icon="Assets/AGLauncher.ico">
 <Border Margin="12" Background="#0E1318" BorderBrush="#29313A" BorderThickness="1" CornerRadius="20">
  <Grid Margin="24">
   <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel>
    <TextBlock Text="Crop profile photo" FontSize="24" FontWeight="SemiBold"/>
    <TextBlock Text="Drag the photo and zoom until the 1:1 square looks right." Foreground="#8793A2" FontSize="13" Margin="0,5,0,0"/>
   </StackPanel>
   <TextBlock Grid.Row="1" Text="The square below is exactly what will be saved." Foreground="#697582" FontSize="12" Margin="0,14,0,10"/>
   <Border x:Name="CropViewport" Grid.Row="2" Width="400" Height="400" HorizontalAlignment="Center" VerticalAlignment="Center"
           Background="#05070A" BorderBrush="#4D7B86" BorderThickness="2" CornerRadius="10" ClipToBounds="True"
           MouseLeftButtonDown="CropViewport_MouseLeftButtonDown" MouseLeftButtonUp="CropViewport_MouseLeftButtonUp"
           MouseMove="CropViewport_MouseMove" MouseLeave="CropViewport_MouseLeave">
    <Grid ClipToBounds="True">
     <Image x:Name="CropImage" Stretch="None" HorizontalAlignment="Left" VerticalAlignment="Top" RenderOptions.BitmapScalingMode="HighQuality">
      <Image.RenderTransform>
       <TransformGroup>
        <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1"/>
        <TranslateTransform x:Name="ImageTranslate"/>
       </TransformGroup>
      </Image.RenderTransform>
     </Image>
     <Border BorderBrush="#D8FFFFFF" BorderThickness="1" CornerRadius="8" IsHitTestVisible="False"/>
    </Grid>
   </Border>
   <Grid Grid.Row="3" Margin="40,16,40,0">
    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock Text="Zoom" Foreground="#9BA7B5" VerticalAlignment="Center" Margin="0,0,12,0"/>
    <Slider x:Name="ZoomSlider" Grid.Column="1" Minimum="1" Maximum="4" Value="1" ValueChanged="ZoomSlider_ValueChanged"/>
    <Button Grid.Column="2" Style="{StaticResource GhostButton}" Content="Reset" Click="Reset_Click" Margin="12,0,0,0"/>
   </Grid>
   <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
    <Button Style="{StaticResource GhostButton}" Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0"/>
    <Button Style="{StaticResource PrimaryButton}" Content="Use this crop" Click="UseCrop_Click"/>
   </StackPanel>
  </Grid>
 </Border>
</Window>
