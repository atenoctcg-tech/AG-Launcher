<Window x:Class="AGLauncher.ProfileWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AG Launcher — Profile" Width="560" Height="470"
 WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
 Background="#080A0D" Icon="Assets/AGLauncher.ico">
 <Border Margin="12" Background="#0E1318" BorderBrush="#29313A" BorderThickness="1" CornerRadius="20">
  <Grid Margin="28">
   <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="130"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock Text="Player profile" FontSize="24" FontWeight="SemiBold"/>
     <TextBlock Text="Local nickname and profile photo. No account or login required." FontSize="12" Foreground="#737D89" Margin="0,5,0,0"/>
    </StackPanel>
    <Image Grid.Column="1" Source="Assets/AGLauncher.ico" Width="42" Height="42"/>
   </Grid>

   <Grid Grid.Row="1" Margin="0,12,0,8">
    <Grid.ColumnDefinitions><ColumnDefinition Width="104"/><ColumnDefinition Width="18"/><ColumnDefinition/></Grid.ColumnDefinitions>
    <Border Width="96" Height="96" CornerRadius="48" Background="#202832" BorderBrush="#364453" BorderThickness="1" ClipToBounds="True">
     <Grid>
      <TextBlock Text="AG" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="22" FontWeight="SemiBold" Foreground="#AAB5C3"/>
      <Image x:Name="PhotoPreview" Stretch="UniformToFill"/>
     </Grid>
    </Border>
    <StackPanel Grid.Column="2" VerticalAlignment="Center">
     <TextBlock Text="Profile photo" Foreground="#9BA4AF" FontSize="12" Margin="0,0,0,8"/>
     <StackPanel Orientation="Horizontal">
      <Button Style="{StaticResource GhostButton}" Content="Choose photo" Click="ChoosePhoto_Click" Margin="0,0,8,0"/>
      <Button Style="{StaticResource GhostButton}" Content="Remove" Click="RemovePhoto_Click"/>
     </StackPanel>
     <TextBlock Text="PNG / JPG / WEBP · max 8 MB · choose any image and crop a 1:1 profile photo" Foreground="#68727E" FontSize="11" TextWrapping="Wrap" Margin="0,8,0,0"/>
    </StackPanel>
   </Grid>

   <StackPanel Grid.Row="2" Margin="0,8,0,0">
    <TextBlock Text="Nickname" Foreground="#9BA4AF" FontSize="12" Margin="0,0,0,6"/>
    <TextBox x:Name="NicknameBox" Height="44" MaxLength="24"/>
   </StackPanel>

   <TextBlock x:Name="StatusText" Grid.Row="3" Foreground="#8994A2" FontSize="12" TextWrapping="Wrap" Margin="0,14,0,0"
              Text="Your profile is stored only on this PC."/>

   <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Style="{StaticResource GhostButton}" Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0"/>
    <Button Style="{StaticResource PrimaryButton}" Content="Save profile" Click="Save_Click"/>
   </StackPanel>
  </Grid>
 </Border>
</Window>
