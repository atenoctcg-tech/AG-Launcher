<Window x:Class="AGLauncher.ProfileWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AG Launcher — Profile" Width="520" Height="350"
 WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
 Background="#080A0D" Icon="Assets/AGLauncher.ico">
 <Border Margin="12" Background="#0E1318" BorderBrush="#29313A" BorderThickness="1" CornerRadius="20">
  <Grid Margin="28">
   <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel>
     <TextBlock Text="Player profile" FontSize="24" FontWeight="SemiBold"/>
     <TextBlock Text="No account or login required." FontSize="10" Foreground="#737D89" Margin="0,5,0,0"/>
    </StackPanel>
    <Image Grid.Column="1" Source="Assets/AGLauncher.ico" Width="42" Height="42"/>
   </Grid>
   <StackPanel Grid.Row="1" Margin="0,18,0,0">
    <TextBlock Text="Nickname" Foreground="#9BA4AF" FontSize="10" Margin="0,0,0,6"/>
    <TextBox x:Name="NicknameBox" Height="44" MaxLength="24"/>
   </StackPanel>
   <TextBlock x:Name="StatusText" Grid.Row="2" Foreground="#8994A2" FontSize="10" TextWrapping="Wrap" Margin="0,14,0,0"
              Text="Nickname is stored only on this PC. Players can use AG Launcher without registering or signing in."/>
   <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Style="{StaticResource GhostButton}" Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0"/>
    <Button Style="{StaticResource PrimaryButton}" Content="Save nickname" Click="Save_Click"/>
   </StackPanel>
  </Grid>
 </Border>
</Window>
