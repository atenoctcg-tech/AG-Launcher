<Window x:Class="AGLauncher.AdminWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AG Launcher — Admin Panel"
 Width="1240" Height="800" MinWidth="1080" MinHeight="680"
 WindowStartupLocation="CenterOwner"
 WindowStyle="None" ResizeMode="CanResizeWithGrip"
 Background="#090A0C" Icon="Assets/AGLauncher.ico">

 <Border Background="#090A0C" BorderBrush="#2A2F36" BorderThickness="1">
  <Grid>
   <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="46"/></Grid.RowDefinitions>

   <Border Grid.Row="0" Background="#0B0D10" BorderBrush="#20242A" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
    <Grid Margin="16,0,8,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Image Source="Assets/AGLauncher.ico" Width="22" Height="22"/>
      <StackPanel Margin="10,0,0,0">
       <TextBlock Text="Admin Panel" FontSize="13" FontWeight="SemiBold"/>
       <TextBlock x:Name="RepoText" Foreground="#646C77" FontSize="11"/>
      </StackPanel>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <Button Style="{StaticResource ChromeButton}" Content="—" Click="Minimize_Click"/>
      <Button Style="{StaticResource ChromeButton}" Content="□" Click="Maximize_Click"/>
      <Button Style="{StaticResource ChromeButton}" Content="×" Click="Close_Click"/>
     </StackPanel>
    </Grid>
   </Border>

   <Grid Grid.Row="1" Margin="18,16,18,10">
    <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>

    <Grid>
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel>
      <TextBlock Text="Launcher management" FontSize="24" FontWeight="SemiBold"/>
      <TextBlock Text="Games, news, social links and launcher updates are published to GitHub." Foreground="#747C87" FontSize="12" Margin="0,4,0,0"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <Button Style="{StaticResource GhostButton}" Content="Validate" Click="Validate_Click" Margin="0,0,8,0"/>
      <Button Style="{StaticResource PrimaryButton}" Content="Save to GitHub" Click="Save_Click"/>
     </StackPanel>
    </Grid>

    <TabControl Grid.Row="1">
     <TabItem Header="LAUNCHER">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
       <Grid Margin="22">
        <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
         <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
         <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
         <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Latest version" Foreground="#9CA3AD" VerticalAlignment="Center"/><TextBox x:Name="LatestVersionBox" Grid.Column="1" Margin="0,5"/>
        <TextBlock Grid.Column="3" Text="Minimum version" Foreground="#9CA3AD" VerticalAlignment="Center"/><TextBox x:Name="MinimumVersionBox" Grid.Column="4" Margin="0,5"/>

        <TextBlock Grid.Row="1" Text="Mandatory update" Foreground="#9CA3AD" VerticalAlignment="Center"/><CheckBox x:Name="MandatoryUpdateCheck" Grid.Row="1" Grid.Column="1" Content="Block old launcher versions until update finishes"/>
        <TextBlock Grid.Row="1" Grid.Column="3" Text="Announcement" Foreground="#9CA3AD" VerticalAlignment="Center"/><TextBox x:Name="AnnouncementBox" Grid.Row="1" Grid.Column="4" Margin="0,5"/>

        <TextBlock Grid.Row="2" Text="Package URL" Foreground="#9CA3AD" VerticalAlignment="Center"/><TextBox x:Name="LauncherPackageUrlBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,5"/>
        <TextBlock Grid.Row="3" Text="SHA-256" Foreground="#9CA3AD" VerticalAlignment="Center"/><TextBox x:Name="LauncherShaBox" Grid.Row="3" Grid.Column="1" Grid.ColumnSpan="4" Margin="0,5"/>

        <TextBlock Grid.Row="4" Text="Default hero title" Foreground="#9CA3AD" VerticalAlignment="Center"/><TextBox x:Name="DefaultHeroTitleBox" Grid.Row="4" Grid.Column="1" Margin="0,5"/>
        <TextBlock Grid.Row="4" Grid.Column="3" Text="Default hero subtitle" Foreground="#9CA3AD" VerticalAlignment="Center"/><TextBox x:Name="DefaultHeroSubtitleBox" Grid.Row="4" Grid.Column="4" Margin="0,5"/>

        <TextBlock Grid.Row="5" Text="Release notes" Foreground="#9CA3AD" VerticalAlignment="Top" Margin="0,12,0,0"/>
        <TextBox x:Name="LauncherReleaseNotesBox" Grid.Row="5" Grid.Column="1" Grid.ColumnSpan="4" Height="150" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Margin="0,5"/>

        <Border Grid.Row="7" Grid.ColumnSpan="5" Background="#101319" BorderBrush="#262B32" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,18,0,0">
         <StackPanel>
          <TextBlock Text="Self-update publishing" FontWeight="SemiBold"/>
          <TextBlock Foreground="#747C87" FontSize="12" TextWrapping="Wrap" Margin="0,6,0,0"
                     Text="Publish the launcher ZIP to a stable GitHub Release URL, paste that URL above, calculate its SHA-256, then increase Latest version."/>
         </StackPanel>
        </Border>
       </Grid>
      </ScrollViewer>
     </TabItem>

     <TabItem Header="LINKS">
      <Grid Margin="22">
       <Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
       <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
       <TextBlock Text="Website" Foreground="#9CA3AD" VerticalAlignment="Center"/><TextBox x:Name="WebsiteBox" Grid.Column="1" Margin="0,5"/>
       <TextBlock Grid.Row="1" Text="Discord" Foreground="#9CA3AD" VerticalAlignment="Center"/><TextBox x:Name="DiscordBox" Grid.Row="1" Grid.Column="1" Margin="0,5"/>
       <TextBlock Grid.Row="2" Text="Telegram" Foreground="#9CA3AD" VerticalAlignment="Center"/><TextBox x:Name="TelegramBox" Grid.Row="2" Grid.Column="1" Margin="0,5"/>
       <TextBlock Grid.Row="3" Text="YouTube" Foreground="#9CA3AD" VerticalAlignment="Center"/><TextBox x:Name="YouTubeBox" Grid.Row="3" Grid.Column="1" Margin="0,5"/>
       <TextBlock Grid.Row="4" Text="Support" Foreground="#9CA3AD" VerticalAlignment="Center"/><TextBox x:Name="SupportBox" Grid.Row="4" Grid.Column="1" Margin="0,5"/>
      </Grid>
     </TabItem>

     <TabItem Header="NEWS">
      <DockPanel Margin="14">
       <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource GhostButton}" Content="Upload image" Click="UploadNewsImage_Click" Margin="0,10,8,0"/>
        <Button Style="{StaticResource GhostButton}" Content="+ Add news" Click="AddNews_Click" Margin="0,10,8,0"/>
        <Button Style="{StaticResource GhostButton}" Content="Duplicate" Click="DuplicateNews_Click" Margin="0,10,8,0"/>
        <Button Style="{StaticResource GhostButton}" Content="Remove selected" Click="RemoveNews_Click" Margin="0,10,0,0"/>
       </StackPanel>
       <DataGrid x:Name="NewsGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single">
        <DataGrid.Columns>
         <DataGridCheckBoxColumn Header="ON" Binding="{Binding Visible}" Width="46"/>
         <DataGridCheckBoxColumn Header="PIN" Binding="{Binding Pinned}" Width="48"/>
         <DataGridTextColumn Header="DATE" Binding="{Binding Date}" Width="94"/>
         <DataGridTextColumn Header="TITLE" Binding="{Binding Title}" Width="190"/>
         <DataGridTextColumn Header="SUMMARY" Binding="{Binding Summary}" Width="*"/>
         <DataGridTextColumn Header="IMAGE URL" Binding="{Binding ImageUrl}" Width="220"/>
         <DataGridTextColumn Header="LINK URL" Binding="{Binding LinkUrl}" Width="220"/>
        </DataGrid.Columns>
       </DataGrid>
      </DockPanel>
     </TabItem>

     <TabItem Header="GAMES">
      <DockPanel Margin="14">
       <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right">
        <Button Style="{StaticResource GhostButton}" Content="Upload banner image" Click="UploadGameBanner_Click" ToolTip="PNG / JPG / WEBP static main banner" Margin="0,10,8,0"/>
        <Button Style="{StaticResource GhostButton}" Content="Upload animated banner" Click="UploadGameAnimatedBanner_Click" ToolTip="GIF / MP4 · looped and muted" Margin="0,10,8,0"/>
        <Button Style="{StaticResource GhostButton}" Content="Upload Library image" Click="UploadGameLibraryImage_Click" ToolTip="Separate image used in My Library" Margin="0,10,8,0"/>
        <Button Style="{StaticResource GhostButton}" Content="Upload QUICK LAUNCH icon" Click="UploadGameIcon_Click" ToolTip="This icon is shown in QUICK LAUNCH" Margin="0,10,8,0"/>
        <Button Style="{StaticResource GhostButton}" Content="+ Add game" Click="AddGame_Click" Margin="0,10,8,0"/>
        <Button Style="{StaticResource GhostButton}" Content="Duplicate" Click="DuplicateGame_Click" Margin="0,10,8,0"/>
        <Button Style="{StaticResource GhostButton}" Content="Remove selected" Click="RemoveGame_Click" Margin="0,10,0,0"/>
       </StackPanel>
       <DataGrid x:Name="GamesGrid" AutoGenerateColumns="False" CanUserAddRows="False" SelectionMode="Single" FrozenColumnCount="4">
        <DataGrid.Columns>
         <DataGridCheckBoxColumn Header="ON" Binding="{Binding Visible}" Width="44"/>
         <DataGridCheckBoxColumn Header="FEATURED" Binding="{Binding Featured}" Width="72"/>
         <DataGridTextColumn Header="SORT" Binding="{Binding SortOrder}" Width="55"/>
         <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="130"/>
         <DataGridTextColumn Header="NAME" Binding="{Binding Name}" Width="155"/>
         <DataGridTextColumn Header="STATUS" Binding="{Binding Status}" Width="105"/>
         <DataGridTextColumn Header="PRICE" Binding="{Binding Pricing}" Width="80"/>
         <DataGridTextColumn Header="DESCRIPTION" Binding="{Binding Description}" Width="260"/>
         <DataGridTextColumn Header="BANNER URL" Binding="{Binding BannerUrl}" Width="220"/>
         <DataGridTextColumn Header="ANIMATED URL" Binding="{Binding AnimatedBannerUrl}" Width="220"/>
         <DataGridTextColumn Header="LIBRARY IMAGE" Binding="{Binding LibraryImageUrl}" Width="220"/>
         <DataGridTextColumn Header="ICON URL" Binding="{Binding IconUrl}" Width="180"/>
         <DataGridTextColumn Header="MANIFEST URL" Binding="{Binding ManifestUrl}" Width="250"/>
         <DataGridTextColumn Header="WEBSITE URL" Binding="{Binding WebsiteUrl}" Width="200"/>
         <DataGridCheckBoxColumn Header="OWNERSHIP" Binding="{Binding RequiresOwnership}" Width="86"/>
         <DataGridTextColumn Header="PRODUCT ID" Binding="{Binding ProductId}" Width="130"/>
         <DataGridTextColumn Header="PURCHASE URL" Binding="{Binding PurchaseUrl}" Width="220"/>
        </DataGrid.Columns>
       </DataGrid>
      </DockPanel>
     </TabItem>

     <TabItem Header="SECURITY">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
       <StackPanel Margin="26" MaxWidth="860" HorizontalAlignment="Left">
        <TextBlock Text="Admin &amp; publishing security" FontSize="20" FontWeight="SemiBold"/>
        <TextBlock TextWrapping="Wrap" Foreground="#8A929D" Margin="0,10,0,0" LineHeight="20"
                   Text="Admin Panel opens with your local password. Save the GitHub token once below; it is encrypted with your admin password and stored only on this PC."/>
        <Border Background="#11161C" BorderBrush="#2A3038" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,18,0,0">
         <StackPanel>
          <TextBlock Text="GitHub publishing token" FontWeight="SemiBold"/>
          <TextBlock x:Name="TokenStateText" Text="No token saved." Foreground="#747C87" FontSize="11" Margin="0,5,0,10"/>
          <PasswordBox x:Name="AdminTokenBox" Height="42"/>
          <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
           <Button Style="{StaticResource PrimaryButton}" Content="Verify &amp; save token" Click="SaveToken_Click" Margin="0,0,8,0"/>
           <Button Style="{StaticResource GhostButton}" Content="Test current token" Click="TestToken_Click"/>
          </StackPanel>
         </StackPanel>
        </Border>
        <Border Background="#111419" BorderBrush="#2A3038" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,16,0,0">
         <StackPanel>
          <TextBlock Text="Image publishing" FontWeight="SemiBold"/>
          <TextBlock TextWrapping="Wrap" Foreground="#747C87" FontSize="12" Margin="0,6,0,0"
                     Text="NEWS and GAMES tabs can upload local JPG/PNG/WEBP images directly to docs/media in GitHub. Launcher and website use the generated public image URL automatically."/>
         </StackPanel>
        </Border>
        <TextBlock TextWrapping="Wrap" Foreground="#8A929D" Margin="0,16,0,0" LineHeight="20"
                   Text="User passwords and private secrets are not stored in the public GitHub repository. Local launcher profiles stay on the user's PC; real cloud accounts need a proper authentication backend."/>
       </StackPanel>
      </ScrollViewer>
     </TabItem>
    <TabItem Header="DESIGN &amp; WORKSHOP"><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="22"><TextBlock Text="Shared design and Workshop" FontSize="24"/><TextBlock Text="Edit theme colors, motion and workshop items. Publish to apply to both the launcher and website." TextWrapping="Wrap" Foreground="#A5B4CA" Margin="0,12,0,20"/><TextBlock Text="Theme JSON (background, panel, card, accent, motion)"/><TextBox x:Name="ThemeJsonBox" AcceptsReturn="True" Height="180" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" Margin="0,8,0,18"/><TextBlock Text="Workshop JSON — array of items: id, name, gameId, category, description, imageUrl, downloadUrl, pricing, visible" TextWrapping="Wrap"/><TextBox x:Name="WorkshopJsonBox" AcceptsReturn="True" Height="260" FontFamily="Consolas" VerticalScrollBarVisibility="Auto" Margin="0,8,0,18"/><Button Content="Open visual web editor" Style="{StaticResource GhostButton}" Click="OpenWebEditor_Click"/></StackPanel></ScrollViewer></TabItem></TabControl>
   </Grid>

   <Border Grid.Row="2" Background="#0B0D10" BorderBrush="#20242A" BorderThickness="0,1,0,0">
    <Grid Margin="18,0"><TextBlock x:Name="StatusText" VerticalAlignment="Center" Foreground="#737B86" FontSize="12" Text="Ready."/><TextBlock Text="Changes are published to launcher-manifest.json" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#454C55" FontSize="11"/></Grid>
   </Border>
  </Grid>
 </Border>
</Window>