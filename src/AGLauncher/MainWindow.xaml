<Window x:Class="AGLauncher.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AG Launcher — Atenoct Games"
 Width="1480" Height="900" MinWidth="1180" MinHeight="720"
 WindowStartupLocation="CenterScreen"
 WindowStyle="None" ResizeMode="CanResizeWithGrip"
 Background="#090A0C" Icon="Assets/AGLauncher.ico"
 KeyDown="Window_KeyDown">

 <Border Background="#090A0C" BorderBrush="#252A31" BorderThickness="1">
  <Grid>
   <Grid.RowDefinitions>
    <RowDefinition Height="48"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="30"/>
   </Grid.RowDefinitions>

   <!-- CUSTOM TITLE BAR -->
   <Border Grid.Row="0" Background="#0B0D10" BorderBrush="#20242A" BorderThickness="0,0,0,1" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
    <Grid Margin="16,0,8,0">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Image Source="Assets/AGLauncher.ico" Width="22" Height="22" Stretch="Uniform"/>
      <TextBlock Text="AG Launcher" FontSize="12" FontWeight="SemiBold" Margin="9,0,0,0"/>
      <TextBlock Text="• Atenoct Games" FontSize="10" Foreground="#646C77" Margin="8,1,0,0"/>
     </StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
      <Button Style="{StaticResource ChromeButton}" Content="—" Click="Minimize_Click"/>
      <Button Style="{StaticResource ChromeButton}" Content="□" Click="Maximize_Click"/>
      <Button Style="{StaticResource ChromeButton}" Content="×" Click="Close_Click"/>
     </StackPanel>
    </Grid>
   </Border>

   <Grid Grid.Row="1">
    <Grid.ColumnDefinitions><ColumnDefinition Width="248"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

    <!-- LEFT APP RAIL -->
    <Border Grid.Column="0" Background="#0C0E11" BorderBrush="#22262D" BorderThickness="0,0,1,0">
     <Grid Margin="18,22,18,16">
      <Grid.RowDefinitions>
       <RowDefinition Height="64"/>
       <RowDefinition Height="132"/>
       <RowDefinition Height="*"/>
       <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <Image Source="Assets/BrandLogo.png" MaxWidth="202" MaxHeight="42" Stretch="Uniform" HorizontalAlignment="Left" VerticalAlignment="Top"/>

      <StackPanel Grid.Row="1" Margin="0,10,0,18">
       <Border Background="#171A1F" CornerRadius="10" Padding="12,10" Margin="0,0,0,7">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <TextBlock Text="◈" Foreground="#DDE1E7" VerticalAlignment="Center"/>
         <TextBlock Grid.Column="1" Text="Discover" FontWeight="SemiBold"/>
        </Grid>
       </Border>
       <Border Background="Transparent" CornerRadius="10" Padding="12,10" Margin="0,0,0,7">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <TextBlock Text="▣" Foreground="#747C87" VerticalAlignment="Center"/>
         <TextBlock Grid.Column="1" Text="Library" Foreground="#A1A7B0"/>
        </Grid>
       </Border>
       <Border Background="Transparent" CornerRadius="10" Padding="12,10">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <TextBlock Text="☆" Foreground="#747C87" VerticalAlignment="Center"/>
         <TextBlock Grid.Column="1" Text="Favorites" Foreground="#A1A7B0"/>
        </Grid>
       </Border>
      </StackPanel>

      <DockPanel Grid.Row="2">
       <TextBlock DockPanel.Dock="Top" Text="YOUR GAMES" Foreground="#626A75" FontSize="10" FontWeight="SemiBold" Margin="8,0,0,8"/>
       <ListBox x:Name="GamesList" Background="Transparent" BorderThickness="0"
                SelectionChanged="GamesList_SelectionChanged"
                ScrollViewer.VerticalScrollBarVisibility="Auto">
        <ListBox.ItemContainerStyle>
         <Style TargetType="ListBoxItem">
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Margin" Value="0,0,0,7"/>
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="Template">
           <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
             <Border x:Name="Row" Background="Transparent" CornerRadius="11" Padding="10,9">
              <ContentPresenter/>
             </Border>
             <ControlTemplate.Triggers>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#1B1F25"/></Trigger>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#171A1F"/></Trigger>
             </ControlTemplate.Triggers>
            </ControlTemplate>
           </Setter.Value>
          </Setter>
         </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
         <DataTemplate>
          <Grid>
           <Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <Border Width="32" Height="32" CornerRadius="8" Background="#242932">
            <TextBlock Text="AG" FontSize="9" FontWeight="Bold" Foreground="#DDE1E7" HorizontalAlignment="Center" VerticalAlignment="Center"/>
           </Border>
           <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding Status}" Foreground="#717985" FontSize="9" Margin="0,2,0,0"/>
           </StackPanel>
          </Grid>
         </DataTemplate>
        </ListBox.ItemTemplate>
       </ListBox>
      </DockPanel>

      <Border Grid.Row="3" Background="#111419" BorderBrush="#252A31" BorderThickness="1" CornerRadius="12" Padding="11">
       <StackPanel>
        <Grid>
         <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <TextBlock Text="AG Launcher" FontSize="11" FontWeight="SemiBold"/>
         <TextBlock Grid.Column="1" Text="v0.2" Foreground="#777F89" FontSize="10"/>
        </Grid>
        <TextBlock x:Name="SideInstallStatusText" Text="Ready" Foreground="#69717C" FontSize="9" Margin="0,6,0,0" TextTrimming="CharacterEllipsis"/>
        <ProgressBar x:Name="SideInstallProgress" Height="4" Minimum="0" Maximum="1" Visibility="Collapsed" Margin="0,8,0,0"/>
        <TextBlock Text="Ctrl + Shift + A  •  Admin" Foreground="#555D68" FontSize="9" Margin="0,8,0,0"/>
       </StackPanel>
      </Border>
     </Grid>
    </Border>

    <!-- CONTENT -->
    <Grid Grid.Column="1">
     <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition Height="*"/></Grid.RowDefinitions>

     <Grid Grid.Row="0" Margin="30,16,30,8">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center">
       <TextBlock Text="Discover" FontSize="23" FontWeight="SemiBold"/>
       <TextBlock Text="Games, updates and news from Atenoct Games" FontSize="10" Foreground="#747C87" Margin="0,3,0,0"/>
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
       <Button x:Name="WebsiteButton" Style="{StaticResource GhostButton}" Content="Website" Tag="website" Click="Social_Click" Margin="0,0,7,0"/>
       <Button x:Name="DiscordButton" Style="{StaticResource GhostButton}" Content="Discord" Tag="discord" Click="Social_Click" Margin="0,0,7,0"/>
       <Button x:Name="TelegramButton" Style="{StaticResource GhostButton}" Content="Telegram" Tag="telegram" Click="Social_Click" Margin="0,0,7,0"/>
       <Button x:Name="YouTubeButton" Style="{StaticResource GhostButton}" Content="YouTube" Tag="youtube" Click="Social_Click" Margin="0,0,7,0"/>
       <Button x:Name="SupportButton" Style="{StaticResource GhostButton}" Content="Support" Tag="support" Click="Social_Click"/>
      </StackPanel>
     </Grid>

     <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Margin="30,6,30,34">

       <!-- HERO -->
       <Border Height="430" CornerRadius="22" ClipToBounds="True" BorderBrush="#2B3038" BorderThickness="1">
        <Grid Background="#111419">
         <Image x:Name="HeroBannerImage" Stretch="UniformToFill" Opacity="0.68"/>
         <Rectangle>
          <Rectangle.Fill>
           <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
            <GradientStop Color="#F20A0C0F" Offset="0"/>
            <GradientStop Color="#D20B0D10" Offset="0.38"/>
            <GradientStop Color="#760B0D10" Offset="0.70"/>
            <GradientStop Color="#240B0D10" Offset="1"/>
           </LinearGradientBrush>
          </Rectangle.Fill>
         </Rectangle>

         <Ellipse Width="530" Height="530" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-300,-220,0" Fill="#0FFFFFFF"/>

         <Grid Margin="42,38">
          <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Width="650" HorizontalAlignment="Left" VerticalAlignment="Center">
           <StackPanel Orientation="Horizontal">
            <Border Background="#20FFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="999" Padding="10,5">
             <TextBlock x:Name="GameStatusText" Text="ATENOCT GAMES" FontSize="9" FontWeight="SemiBold" Foreground="#E1E5EA"/>
            </Border>
            <Border x:Name="PricingBadge" Background="#15181D" BorderBrush="#30353D" BorderThickness="1" CornerRadius="999" Padding="10,5" Margin="8,0,0,0">
             <TextBlock x:Name="PricingText" Text="FREE" FontSize="9" FontWeight="SemiBold" Foreground="#B6BDC7"/>
            </Border>
           </StackPanel>

           <TextBlock x:Name="GameTitleText" Text="AG Launcher" FontSize="52" FontWeight="SemiBold" Margin="0,16,0,12" TextWrapping="Wrap"/>
           <TextBlock x:Name="GameDescriptionText" Text="Select a game." FontSize="15" Foreground="#A3AAB4" MaxWidth="640" TextWrapping="Wrap" LineHeight="23"/>
          </StackPanel>

          <Grid Grid.Row="1">
           <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
           <Button x:Name="GameActionButton" Style="{StaticResource PrimaryButton}" Content="SELECT GAME" MinWidth="174" Height="48" Click="GameActionButton_Click"/>
           <Button x:Name="GameWebsiteButton" Grid.Column="1" Style="{StaticResource GhostButton}" Content="Game website" Height="48" Margin="10,0,0,0" Click="GameWebsiteButton_Click" Visibility="Collapsed"/>
           <StackPanel Grid.Column="2" Margin="20,0,0,0" VerticalAlignment="Center">
            <TextBlock x:Name="InstallStatusText" Foreground="#858D98" FontSize="10"/>
            <ProgressBar x:Name="InstallProgress" Height="5" Minimum="0" Maximum="1" Visibility="Collapsed" Margin="0,7,0,0"/>
           </StackPanel>
          </Grid>
         </Grid>
        </Grid>
       </Border>

       <Grid Margin="2,24,2,12">
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <StackPanel>
         <TextBlock Text="Latest news" FontSize="18" FontWeight="SemiBold"/>
         <TextBlock Text="Announcements, releases and development updates" Foreground="#6E7681" FontSize="10" Margin="0,3,0,0"/>
        </StackPanel>
        <TextBlock Grid.Column="1" Text="Double-click a card to open" Foreground="#555D68" FontSize="9" VerticalAlignment="Bottom"/>
       </Grid>

       <!-- NEWS GRID -->
       <ListBox x:Name="NewsList" Background="Transparent" BorderThickness="0"
                MouseDoubleClick="NewsList_MouseDoubleClick"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                ScrollViewer.VerticalScrollBarVisibility="Disabled">
        <ListBox.ItemsPanel>
         <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
        </ListBox.ItemsPanel>
        <ListBox.ItemContainerStyle>
         <Style TargetType="ListBoxItem">
          <Setter Property="Padding" Value="0"/>
          <Setter Property="Margin" Value="0,0,14,14"/>
          <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
          <Setter Property="Template">
           <Setter.Value>
            <ControlTemplate TargetType="ListBoxItem">
             <Border x:Name="CardBorder" Background="#111419" BorderBrush="#242931" BorderThickness="1" CornerRadius="16">
              <ContentPresenter/>
             </Border>
             <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CardBorder" Property="Background" Value="#171A1F"/><Setter TargetName="CardBorder" Property="BorderBrush" Value="#343A43"/></Trigger>
              <Trigger Property="IsSelected" Value="True"><Setter TargetName="CardBorder" Property="BorderBrush" Value="#555D68"/></Trigger>
             </ControlTemplate.Triggers>
            </ControlTemplate>
           </Setter.Value>
          </Setter>
         </Style>
        </ListBox.ItemContainerStyle>
        <ListBox.ItemTemplate>
         <DataTemplate>
          <Grid Width="318" Height="252">
           <Grid.RowDefinitions><RowDefinition Height="142"/><RowDefinition Height="*"/></Grid.RowDefinitions>
           <Border Background="#171A1F" CornerRadius="15,15,0,0" ClipToBounds="True">
            <Grid>
             <Image Source="{Binding ImageUrl}" Stretch="UniformToFill"/>
             <Rectangle>
              <Rectangle.Fill>
               <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#00000000" Offset="0.45"/>
                <GradientStop Color="#A0000000" Offset="1"/>
               </LinearGradientBrush>
              </Rectangle.Fill>
             </Rectangle>
             <Border Background="#CC111419" CornerRadius="999" Padding="8,4" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="10" Visibility="{Binding Pinned, Converter={x:Static BooleanToVisibilityConverter.Instance}}">
              <TextBlock Text="FEATURED" FontSize="8" FontWeight="Bold"/>
             </Border>
            </Grid>
           </Border>
           <StackPanel Grid.Row="1" Margin="14,12,14,12">
            <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap" MaxHeight="38"/>
            <TextBlock Text="{Binding Summary}" Foreground="#7B838E" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,5" MaxHeight="34"/>
            <TextBlock Text="{Binding Date}" Foreground="#555D68" FontSize="9"/>
           </StackPanel>
          </Grid>
         </DataTemplate>
        </ListBox.ItemTemplate>
       </ListBox>
      </StackPanel>
     </ScrollViewer>
    </Grid>
   </Grid>

   <!-- STATUS BAR -->
   <Border Grid.Row="2" Background="#0B0D10" BorderBrush="#20242A" BorderThickness="0,1,0,0">
    <Grid Margin="18,0">
     <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="ConnectionText" Text="Connecting to GitHub..." Foreground="#68707A" FontSize="9" VerticalAlignment="Center"/>
     <TextBlock Grid.Column="1" Text="ATENOCT GAMES LAUNCHER" Foreground="#3F464F" FontSize="8" VerticalAlignment="Center"/>
    </Grid>
   </Border>
  </Grid>
 </Border>
</Window>