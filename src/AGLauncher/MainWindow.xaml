<Window x:Class="AGLauncher.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AG Launcher — Atenoct Games" Width="1440" Height="880" MinWidth="1180" MinHeight="720"
 WindowStartupLocation="CenterScreen" Background="#090A0C" KeyDown="Window_KeyDown">
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

  <!-- LEFT APP RAIL -->
  <Border Grid.Column="0" Background="#0C0E11" BorderBrush="#22262D" BorderThickness="0,0,1,0">
   <Grid Margin="18,22">
    <Grid.RowDefinitions><RowDefinition Height="74"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Top">
     <Border Width="46" Height="46" CornerRadius="12" Background="#F1F3F5">
      <TextBlock Text="AG" Foreground="#0B0C0E" FontSize="19" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
     </Border>
     <StackPanel Margin="12,2,0,0"><TextBlock Text="AG LAUNCHER" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="ATENOCT GAMES" FontSize="10" Foreground="#767D88" Margin="0,4,0,0"/></StackPanel>
    </StackPanel>

    <StackPanel Grid.Row="1" Margin="0,8,0,18">
     <Border Background="#171A1F" CornerRadius="10" Padding="12,10" Margin="0,0,0,7"><TextBlock Text="◈  Discover" FontWeight="SemiBold"/></Border>
     <Border Background="Transparent" CornerRadius="10" Padding="12,10" Margin="0,0,0,7"><TextBlock Text="▣  Library" Foreground="#A1A7B0"/></Border>
     <Border Background="Transparent" CornerRadius="10" Padding="12,10"><TextBlock Text="☆  Favorites" Foreground="#A1A7B0"/></Border>
    </StackPanel>

    <DockPanel Grid.Row="2">
     <StackPanel DockPanel.Dock="Top">
      <TextBlock Text="YOUR GAMES" Foreground="#626A75" FontSize="10" FontWeight="SemiBold" Margin="8,0,0,8"/>
     </StackPanel>
     <ListBox x:Name="GamesList" Background="Transparent" BorderThickness="0" SelectionChanged="GamesList_SelectionChanged" ScrollViewer.VerticalScrollBarVisibility="Auto">
      <ListBox.ItemContainerStyle>
       <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,7"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template">
         <Setter.Value><ControlTemplate TargetType="ListBoxItem">
          <Border x:Name="Row" Background="Transparent" CornerRadius="10" Padding="11,10">
           <ContentPresenter/>
          </Border>
          <ControlTemplate.Triggers>
           <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#1B1F25"/></Trigger>
           <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#171A1F"/></Trigger>
          </ControlTemplate.Triggers>
         </Setter.Value></Setter>
        </Setter>
       </Style>
      </ListBox.ItemContainerStyle>
      <ListBox.ItemTemplate>
       <DataTemplate>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Border Width="32" Height="32" CornerRadius="8" Background="#242932"><TextBlock Text="G" FontWeight="Bold" Foreground="#DDE1E7" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
         <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12"/><TextBlock Text="{Binding Status}" Foreground="#717985" FontSize="9" Margin="0,2,0,0"/></StackPanel>
        </Grid>
       </DataTemplate>
      </ListBox.ItemTemplate>
     </ListBox>
    </DockPanel>

    <Border Grid.Row="3" Background="#121419" BorderBrush="#252A31" BorderThickness="1" CornerRadius="12" Padding="11">
     <StackPanel>
      <TextBlock Text="AG Launcher v0.1" FontSize="11" FontWeight="SemiBold"/>
      <TextBlock Text="Ctrl + Shift + A  •  Admin" Foreground="#69717C" FontSize="9" Margin="0,3,0,0"/>
     </StackPanel>
    </Border>
   </Grid>
  </Border>

  <!-- MAIN -->
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/><RowDefinition Height="36"/></Grid.RowDefinitions>

   <Grid Grid.Row="0" Margin="28,18,28,10">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <StackPanel><TextBlock Text="Discover" FontSize="24" FontWeight="SemiBold"/><TextBlock Text="Games, updates and news from Atenoct Games" FontSize="11" Foreground="#747C87" Margin="0,4,0,0"/></StackPanel>
    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
     <Button x:Name="DiscordButton" Style="{StaticResource GhostButton}" Content="Discord" Tag="discord" Click="Social_Click" Margin="0,0,8,0"/>
     <Button x:Name="TelegramButton" Style="{StaticResource GhostButton}" Content="Telegram" Tag="telegram" Click="Social_Click" Margin="0,0,8,0"/>
     <Button x:Name="YouTubeButton" Style="{StaticResource GhostButton}" Content="YouTube" Tag="youtube" Click="Social_Click"/>
    </StackPanel>
   </Grid>

   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
    <Grid Margin="28,6,28,28">
     <Grid.RowDefinitions><RowDefinition Height="440"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

     <!-- HERO -->
     <Border Grid.Row="0" CornerRadius="22" ClipToBounds="True" BorderBrush="#2B3038" BorderThickness="1">
      <Border.Background>
       <RadialGradientBrush GradientOrigin="0.85,0.15" Center="0.85,0.15" RadiusX="1.1" RadiusY="1.1">
        <GradientStop Color="#30353D" Offset="0"/>
        <GradientStop Color="#171A20" Offset="0.45"/>
        <GradientStop Color="#0D0F12" Offset="1"/>
       </RadialGradientBrush>
      </Border.Background>
      <Grid>
       <Ellipse Width="520" Height="520" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-240,-180,0" Fill="#12FFFFFF"/>
       <Ellipse Width="380" Height="380" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,-110,-240" Fill="#08000000"/>
       <Grid Margin="42,38">
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Width="610" HorizontalAlignment="Left" VerticalAlignment="Center">
         <Border Background="#1DFFFFFF" BorderBrush="#28FFFFFF" BorderThickness="1" CornerRadius="999" HorizontalAlignment="Left" Padding="10,5">
          <TextBlock x:Name="GameStatusText" Text="ATENOCT GAMES" FontSize="10" FontWeight="SemiBold" Foreground="#DDE1E6"/>
         </Border>
         <TextBlock x:Name="GameTitleText" Text="AG Launcher" FontSize="52" FontWeight="SemiBold" Margin="0,16,0,12" TextWrapping="Wrap"/>
         <TextBlock x:Name="GameDescriptionText" Text="Select a game." FontSize="15" Foreground="#A3AAB4" MaxWidth="610" TextWrapping="Wrap" LineHeight="23"/>
        </StackPanel>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <Button x:Name="GameActionButton" Style="{StaticResource PrimaryButton}" Content="SELECT GAME" MinWidth="170" Height="48" Click="GameActionButton_Click"/>
         <StackPanel Grid.Column="1" Margin="18,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="InstallStatusText" Foreground="#858D98" FontSize="10"/>
          <ProgressBar x:Name="InstallProgress" Height="5" Minimum="0" Maximum="1" Visibility="Collapsed" Margin="0,7,0,0"/>
         </StackPanel>
        </Grid>
       </Grid>
      </Grid>
     </Border>

     <Grid Grid.Row="1" Margin="0,22,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="330"/></Grid.ColumnDefinitions>
      <StackPanel>
       <TextBlock Text="Featured" FontSize="17" FontWeight="SemiBold" Margin="2,0,0,12"/>
       <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Background="#12151A" BorderBrush="#242931" BorderThickness="1" CornerRadius="16" Height="154" Margin="0,0,10,0" Padding="18">
         <StackPanel VerticalAlignment="Bottom"><TextBlock Text="Castle Survival" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Medieval survival strategy" Foreground="#747C87" FontSize="10" Margin="0,5,0,0"/></StackPanel>
        </Border>
        <Border Grid.Column="1" Background="#12151A" BorderBrush="#242931" BorderThickness="1" CornerRadius="16" Height="154" Margin="5,0" Padding="18">
         <StackPanel VerticalAlignment="Bottom"><TextBlock Text="More games" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Coming to AG Launcher" Foreground="#747C87" FontSize="10" Margin="0,5,0,0"/></StackPanel>
        </Border>
        <Border Grid.Column="2" Background="#12151A" BorderBrush="#242931" BorderThickness="1" CornerRadius="16" Height="154" Margin="10,0,0,0" Padding="18">
         <StackPanel VerticalAlignment="Bottom"><TextBlock Text="Auto updates" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="Always stay on the latest build" Foreground="#747C87" FontSize="10" Margin="0,5,0,0"/></StackPanel>
        </Border>
       </Grid>
      </StackPanel>

      <Border Grid.Column="1" Background="#101217" BorderBrush="#242931" BorderThickness="1" CornerRadius="16" Margin="22,0,0,0" Padding="16">
       <DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="2,0,2,8"><TextBlock Text="Latest news" FontSize="16" FontWeight="SemiBold"/><TextBlock Text="Double-click a post to open" Foreground="#69717C" FontSize="9" Margin="0,3,0,0"/></StackPanel>
        <ListBox x:Name="NewsList" Background="Transparent" BorderThickness="0" MouseDoubleClick="NewsList_MouseDoubleClick">
         <ListBox.ItemContainerStyle><Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,4"/></Style></ListBox.ItemContainerStyle>
         <ListBox.ItemTemplate><DataTemplate>
          <Border Background="#15181D" CornerRadius="11" Padding="12">
           <StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/><TextBlock Text="{Binding Summary}" Foreground="#7B838E" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,5" MaxHeight="34"/><TextBlock Text="{Binding Date}" Foreground="#555D68" FontSize="9"/></StackPanel>
          </Border>
         </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
       </DockPanel>
      </Border>
     </Grid>
    </Grid>
   </ScrollViewer>

   <Border Grid.Row="2" Background="#0C0E11" BorderBrush="#20242A" BorderThickness="0,1,0,0">
    <TextBlock x:Name="ConnectionText" Text="Connecting to GitHub..." Foreground="#68707A" FontSize="9" VerticalAlignment="Center" Margin="28,0"/>
   </Border>
  </Grid>
 </Grid>
</Window>