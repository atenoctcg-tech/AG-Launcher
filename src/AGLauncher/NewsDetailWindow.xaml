<Window x:Class="AGLauncher.NewsDetailWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="News" Width="1040" Height="760" MinWidth="860" MinHeight="640"
 WindowStartupLocation="CenterOwner" WindowStyle="None" ResizeMode="CanResizeWithGrip"
 Background="#080A0D" Icon="Assets/AGLauncher.ico" ShowInTaskbar="False"
 PreviewKeyDown="Window_PreviewKeyDown">
 <Border Margin="12" Background="#101A29" BorderBrush="#34465E" BorderThickness="1" CornerRadius="18">
  <Grid>
   <Grid.RowDefinitions>
    <RowDefinition Height="46"/>
    <RowDefinition Height="420"/>
    <RowDefinition Height="*"/>
   </Grid.RowDefinitions>

   <Border Background="#0C121B" BorderBrush="#283544" BorderThickness="0,0,0,1" CornerRadius="18,18,0,0"
           MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
    <Grid Margin="18,0,8,0">
     <TextBlock Text="ATENOCT GAMES  •  LATEST NEWS" Foreground="#718199" FontSize="12" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <Button HorizontalAlignment="Right" Width="38" Height="32" Content="×" FontSize="18"
             Style="{StaticResource ChromeButton}" Click="Close_Click"/>
    </Grid>
   </Border>

   <Border Grid.Row="1" Margin="28,18,28,0" Background="#05080C" CornerRadius="14" ClipToBounds="True">
    <Image Source="{Binding ImageUrl}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality"/>
   </Border>

   <Grid Grid.Row="2" Margin="28,18,28,24">
    <Grid.RowDefinitions>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="Auto"/>
     <RowDefinition Height="*"/>
     <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Text="{Binding Date}" Foreground="#718199" FontSize="12" FontWeight="SemiBold"/>
    <TextBlock Grid.Row="1" Text="{Binding Title}" Foreground="#F5F7FB" FontSize="28" FontWeight="SemiBold"
               TextWrapping="Wrap" Margin="0,10,0,12"/>

    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
     <TextBlock Text="{Binding Summary}" Foreground="#B6C0CE" FontSize="14" LineHeight="22" TextWrapping="Wrap"/>
    </ScrollViewer>

    <Button x:Name="LinkButton" Grid.Row="3" Style="{StaticResource PrimaryButton}" Content="OPEN LINK  →"
            HorizontalAlignment="Left" Margin="0,16,0,0" Click="LinkButton_Click" Visibility="Collapsed"/>
   </Grid>
  </Grid>
 </Border>
</Window>