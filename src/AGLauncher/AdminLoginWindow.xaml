<Window x:Class="AGLauncher.AdminLoginWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AG Launcher Admin" Width="540" Height="340" WindowStartupLocation="CenterOwner" ResizeMode="NoResize" Background="#0B0D10">
 <Border Margin="1" BorderBrush="#2A2F36" BorderThickness="1" CornerRadius="18" Background="#0E1014">
  <Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><TextBlock Text="Admin access" FontSize="26" FontWeight="SemiBold"/><TextBlock Text="AG LAUNCHER" Foreground="#666E79" FontSize="10" Margin="0,5,0,0"/></StackPanel>
   <TextBlock Grid.Row="1" Margin="0,20,0,12" TextWrapping="Wrap" Foreground="#8A929D" Text="GitHub Personal Access Token kiriting. Token faqat joriy sessiyada ishlatiladi va diskka saqlanmaydi."/>
   <PasswordBox x:Name="TokenBox" Grid.Row="2" Height="42" Padding="12" Background="#13161B" Foreground="White" BorderBrush="#292E36" CaretBrush="White"/>
   <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,12,0,0" Foreground="#B5BBC4" TextWrapping="Wrap"/>
   <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right"><Button Style="{StaticResource GhostButton}" Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0"/><Button Style="{StaticResource PrimaryButton}" Content="Verify &amp; open" Click="Verify_Click"/></StackPanel>
  </Grid>
 </Border>
</Window>