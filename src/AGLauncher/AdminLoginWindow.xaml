<Window x:Class="AGLauncher.AdminLoginWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="AG Launcher Admin"
 Width="560" Height="390"
 WindowStartupLocation="CenterOwner"
 ResizeMode="NoResize"
 Background="#090A0C"
 Icon="Assets/AGLauncher.ico">
 <Border Margin="12" BorderBrush="#2A2F36" BorderThickness="1" CornerRadius="18" Background="#0E1014">
  <Grid Margin="30">
   <Grid.RowDefinitions>
    <RowDefinition Height="66"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="Auto"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="Auto"/>
   </Grid.RowDefinitions>

   <Image Source="Assets/BrandLogo.png" MaxWidth="250" MaxHeight="48" Stretch="Uniform" HorizontalAlignment="Left"/>

   <StackPanel Grid.Row="1" Margin="0,12,0,14">
    <TextBlock Text="Admin access" FontSize="24" FontWeight="SemiBold"/>
    <TextBlock TextWrapping="Wrap" Foreground="#7D8590" FontSize="10" Margin="0,6,0,0"
               Text="GitHub Personal Access Token kiriting. Token faqat joriy admin sessiyada xotirada ishlatiladi va diskka saqlanmaydi."/>
   </StackPanel>

   <PasswordBox x:Name="TokenBox" Grid.Row="2" Height="44"/>

   <TextBlock x:Name="StatusText" Grid.Row="3" Margin="0,12,0,0" Foreground="#AEB4BC" TextWrapping="Wrap"/>

   <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
    <Button Style="{StaticResource GhostButton}" Content="Cancel" Click="Cancel_Click" Margin="0,0,8,0"/>
    <Button Style="{StaticResource PrimaryButton}" Content="Verify &amp; open" Click="Verify_Click"/>
   </StackPanel>
  </Grid>
 </Border>
</Window>